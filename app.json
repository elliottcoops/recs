{
  "expo": {
    "name": "SpotCheck",
    "slug": "recs",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SpotCheck lets you add a photo to your place recommendation."
        }
      ],
      "expo-secure-store",
      [
        "expo-calendar",
        {
          "calendarPermission": "Recs uses your calendar to add plans you choose to attend."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SpotCheck uses your location to show nearby venues and directions.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.elliottcoopssteam.recs"
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "7594ab99-d2f1-4861-b62c-ff328f8e3093"
      }
    },
    "owner": "elliottcoopss-team"
  }
}
