{
  "expo": {
    "name": "SpotCheck",
    "slug": "spotcheck",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "SpotCheck lets you add a photo to your place recommendation."
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SpotCheck uses your location to show nearby venues and directions."
      }
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    }
  }
}
